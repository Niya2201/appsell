# ==============================================================================
# ReplyFlow AI - Environment Variables Configuration
# ==============================================================================

# AI Configuration (Gemini API for intent classification and natural conversation)
GEMINI_API_KEY="demo_gemini_api_key_placeholder"

# Database / Backend Store (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/replyflow_ai"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Payments & Subscriptions
REVENUECAT_API_KEY="demo_revenuecat_key_placeholder"
PAYMENT_PROVIDER_SECRET="demo_payment_secret_placeholder"

# Meta WhatsApp Business Cloud API (Official Webhook & Messaging)
WHATSAPP_ACCESS_TOKEN="demo_whatsapp_access_token_placeholder"
WHATSAPP_VERIFY_TOKEN="replyflow_secure_webhook_verify_token_2026"
WHATSAPP_PHONE_NUMBER_ID="demo_whatsapp_phone_number_id_placeholder"

# Application Mode
DEMO_MODE="true"
PORT="3000"
